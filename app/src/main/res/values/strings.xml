    <string name="limitaciones_titulo">Limitaciones</string>
    <string name="limitaciones_texto">La aplicación reconocerá un vocabulario limitado de señas verificadas de la LSC. No traduce toda la lengua de señas. Las frases que proponga la IA se mostrarán aparte y siempre podrás corregirlas.</string>

