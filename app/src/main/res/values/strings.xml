    <!-- IA local (modelo de lenguaje) -->
    <string name="ia_titulo">IA para proponer frases</string>
    <string name="ia_explicacion">Un modelo de lenguaje en el teléfono ordena las señas reconocidas en una frase más natural en español. Es opcional: sin él, la app une los significados con reglas.</string>
    <string name="ia_privacidad">Funciona sin Internet una vez instalado. Solo recibe las señas reconocidas (texto), nunca imágenes. Sus propuestas se validan: si añade señas que no hiciste, se descartan.</string>
