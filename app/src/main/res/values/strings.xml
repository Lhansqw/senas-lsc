    <string name="permiso_texto">Para reconocer señas, la app tiene que ver tus manos con la cámara frontal mientras esta pantalla está abierta.</string>
    <string name="permiso_texto_rechazado">Sin la cámara la app no puede ver las señas. Puedes permitirla ahora o volver al inicio.</string>
