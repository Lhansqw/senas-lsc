# Dependencias nativas de la app de iPhone (el reloj no necesita ninguna).
# MediaPipe para iOS solo se distribuye por CocoaPods.
platform :ios, '17.0'
use_frameworks! :linkage => :static

project 'SenasLSC.xcodeproj'

target 'SenasLSC' do
  # Hand Landmarker + Pose Landmarker (no hay Holistic Landmarker para iOS).
  pod 'MediaPipeTasksVision', '~> 0.10.21'
  # Ejecuta reconocedor_lsc.tflite, el mismo modelo que LiteRT en Android.
  pod 'TensorFlowLiteSwift', '~> 2.17.0'
end

# MediaPipeTasksCommon ya lleva TensorFlow Lite dentro: si TensorFlowLiteSwift (y con él
# TensorFlowLiteC) también se enlaza estático en la app, el enlazador encuentra 54 símbolos
# duplicados. Como framework dinámico, su copia de TFLite queda dentro de su propia imagen.
pre_install do |installer|
  installer.pod_targets.each do |pod|
    next unless pod.name == 'TensorFlowLiteSwift'
    def pod.build_type
      Pod::BuildType.dynamic_framework
    end
  end
end
